# AssemblyAI Voice Agent API key — https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# LiveKit server URL. Use your LiveKit Cloud URL (wss://<project>.livekit.cloud)
# or a self-hosted server URL (e.g. ws://localhost:7880).
LIVEKIT_URL=

# LiveKit API key + secret — find them in the LiveKit Cloud dashboard,
# or generate them when you self-host (`livekit-server generate-keys`).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Room the worker will join. Anyone connecting to the same room with a valid
# LiveKit token will be able to talk to the agent.
ROOM_NAME=voice-agent-demo
