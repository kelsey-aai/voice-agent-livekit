# AssemblyAI API key — https://www.assemblyai.com/dashboard/signup
# One key covers speech-to-text (Universal-3.6 Pro Realtime), the LLM Gateway,
# and text-to-speech (assemblyai-tts-1).
ASSEMBLYAI_API_KEY=

# Not needed for console mode, only to connect to LiveKit.
# Use your LiveKit Cloud URL (wss://<project>.livekit.cloud)
# or a self-hosted server URL (e.g. ws://localhost:7880).
LIVEKIT_URL=

# LiveKit API key + secret — LiveKit Cloud → Settings → Keys,
# or generate them when you self-host (`livekit-server generate-keys`).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
